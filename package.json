{
  "name": "myscreen-desktop",
  "productName": "MyScreen",
  "version": "1.0.2",
  "description": "MyScreen para Windows: tela, som do sistema e câmera na mesma sala.",
  "author": "MyScreen",
  "license": "MIT",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:native": "node scripts/build-native.mjs",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build:native && npm run build && electron-builder --win --publish never",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:native": "cargo test --release --lib --manifest-path native/Cargo.toml",
    "check": "npm run typecheck && npm run test && npm run test:native",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "publish:desktop": "powershell -ExecutionPolicy Bypass -File scripts/publish-desktop.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/spline-sans-mono": "^5.3.0",
    "@livekit/components-react": "2.9.24",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "clsx": "^2.1.1",
    "electron": "44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "livekit-client": "2.22.3",
    "lucide-react": "^1.48.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
